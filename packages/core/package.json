{
  "name": "@jchaffin/voicekit-core",
  "version": "1.0.0-alpha.0",
  "description": "Event journal and kernel primitives for VoiceKit",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --platform node --target es2022 --no-config",
    "typecheck": "tsc --noEmit",
    "test": "tsup --config tsup.test.config.ts && node --test .test-dist/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@jchaffin/voicekit-protocol": "1.0.0-alpha.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
