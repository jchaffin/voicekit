{
  "name": "@jchaffin/voicekit-conformance",
  "version": "1.0.0-alpha.0",
  "description": "Reusable adapter conformance suites and live certification runner for VoiceKit",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "voicekit-certify": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm,cjs --dts --clean --platform node --target es2022 --no-config",
    "typecheck": "tsc --noEmit",
    "test": "tsup --config tsup.test.config.ts && node --test .test-dist/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
