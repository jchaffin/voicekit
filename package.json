{
  "name": "@jchaffin/voicekit",
  "version": "1.0.0-alpha.1",
  "description": "A provider-agnostic React library for building voice-enabled AI agents",
  "workspaces": [
    "packages/*"
  ],
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./v1": {
      "types": "./dist/v1.d.ts",
      "import": "./dist/v1.mjs",
      "require": "./dist/v1.js"
    },
    "./openai": {
      "types": "./dist/adapters/openai.d.ts",
      "import": "./dist/adapters/openai.mjs",
      "require": "./dist/adapters/openai.js"
    },
    "./livekit": {
      "types": "./dist/adapters/livekit.d.ts",
      "import": "./dist/adapters/livekit.mjs",
      "require": "./dist/adapters/livekit.js"
    },
    "./livekit-agents": {
      "types": "./dist/adapters/livekit-agents.d.ts",
      "import": "./dist/adapters/livekit-agents.mjs",
      "require": "./dist/adapters/livekit-agents.js"
    },
    "./deepgram": {
      "types": "./dist/adapters/deepgram.d.ts",
      "import": "./dist/adapters/deepgram.mjs",
      "require": "./dist/adapters/deepgram.js"
    },
    "./elevenlabs": {
      "types": "./dist/adapters/elevenlabs.d.ts",
      "import": "./dist/adapters/elevenlabs.mjs",
      "require": "./dist/adapters/elevenlabs.js"
    },
    "./assemblyai": {
      "types": "./dist/adapters/assemblyai.d.ts",
      "import": "./dist/adapters/assemblyai.mjs",
      "require": "./dist/adapters/assemblyai.js"
    },
    "./pipecat": {
      "types": "./dist/adapters/pipecat.d.ts",
      "import": "./dist/adapters/pipecat.mjs",
      "require": "./dist/adapters/pipecat.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.mjs",
      "require": "./dist/events.js"
    },
    "./toolkit": {
      "types": "./dist/toolkit.d.ts",
      "import": "./dist/toolkit.mjs",
      "require": "./dist/toolkit.js"
    },
    "./outcome": {
      "types": "./dist/core/outcome.d.ts",
      "import": "./dist/core/outcome.mjs",
      "require": "./dist/core/outcome.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    },
    "./pipeline": {
      "types": "./dist/pipeline/index.d.ts",
      "import": "./dist/pipeline/index.mjs",
      "require": "./dist/pipeline/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "npm run build:workspaces && npm run build:legacy",
    "build:legacy": "tsup",
    "build:workspaces": "npm run build --workspaces --if-present",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run build:workspaces && tsc --noEmit && npm run typecheck:examples",
    "typecheck:examples": "tsc --noEmit -p examples/tsconfig.json",
    "test": "npm run test --workspaces --if-present",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "voice",
    "ai",
    "openai",
    "livekit",
    "deepgram",
    "elevenlabs",
    "assemblyai",
    "pipecat",
    "realtime",
    "react",
    "agent",
    "webrtc",
    "speech",
    "vad",
    "barge-in",
    "stt",
    "tts"
  ],
  "author": "Jacob Chaffin",
  "license": "MIT",
  "homepage": "https://github.com/jchaffin/voicekit#readme",
  "bugs": {
    "url": "https://github.com/jchaffin/voicekit/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@11.17.0",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@cartesia/cartesia-js": ">=1.0.0",
    "@deepgram/sdk": ">=3.0.0",
    "@elevenlabs/elevenlabs-js": ">=2.0.0",
    "@livekit/agents": ">=1.9.0",
    "@openai/agents": ">=0.4.0",
    "assemblyai": ">=4.0.0",
    "livekit-client": ">=2.0.0",
    "livekit-server-sdk": ">=2.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "zod": ">=3.0.0 || >=4.0.0"
  },
  "peerDependenciesMeta": {
    "@cartesia/cartesia-js": {
      "optional": true
    },
    "@elevenlabs/elevenlabs-js": {
      "optional": true
    },
    "@openai/agents": {
      "optional": true
    },
    "livekit-client": {
      "optional": true
    },
    "livekit-server-sdk": {
      "optional": true
    },
    "@livekit/agents": {
      "optional": true
    },
    "@deepgram/sdk": {
      "optional": true
    },
    "assemblyai": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@openai/agents": ">=0.0.15",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jchaffin/voicekit"
  },
  "dependencies": {
    "@jchaffin/voicekit-conformance": "1.0.0-alpha.1",
    "@jchaffin/voicekit-core": "1.0.0-alpha.1",
    "@jchaffin/voicekit-deploy": "1.0.0-alpha.1",
    "@jchaffin/voicekit-experiments": "1.0.0-alpha.1",
    "@jchaffin/voicekit-graph": "1.0.0-alpha.1",
    "@jchaffin/voicekit-persistence": "1.0.0-alpha.1",
    "@jchaffin/voicekit-pipeline": "1.0.0-alpha.1",
    "@jchaffin/voicekit-policy": "1.0.0-alpha.1",
    "@jchaffin/voicekit-protocol": "1.0.0-alpha.1",
    "@jchaffin/voicekit-provider-assemblyai": "1.0.0-alpha.1",
    "@jchaffin/voicekit-provider-cartesia": "1.0.0-alpha.1",
    "@jchaffin/voicekit-provider-deepgram": "1.0.0-alpha.1",
    "@jchaffin/voicekit-provider-elevenlabs": "1.0.0-alpha.1",
    "@jchaffin/voicekit-provider-openai": "1.0.0-alpha.1",
    "@jchaffin/voicekit-provider-openai-live": "1.0.0-alpha.1",
    "@jchaffin/voicekit-react": "1.0.0-alpha.1",
    "@jchaffin/voicekit-runtime-livekit": "1.0.0-alpha.1",
    "@jchaffin/voicekit-runtime-pipecat": "1.0.0-alpha.1",
    "@jchaffin/voicekit-session": "1.0.0-alpha.1",
    "@jchaffin/voicekit-simulation": "1.0.0-alpha.1",
    "@jchaffin/voicekit-telemetry": "1.0.0-alpha.1",
    "@jchaffin/voicekit-tools": "1.0.0-alpha.1",
    "@jchaffin/voicekit-transport-livekit": "1.0.0-alpha.1",
    "@jchaffin/voicekit-ui": "1.0.0-alpha.1",
    "@xstate/react": "^6.1.0",
    "xstate": "^5.33.3"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
