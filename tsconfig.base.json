{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@jchaffin/voicekit-protocol": ["packages/protocol/src/index.ts"],
      "@jchaffin/voicekit-core": ["packages/core/src/index.ts"],
      "@jchaffin/voicekit-session": ["packages/session/src/index.ts"],
      "@jchaffin/voicekit-graph": ["packages/graph/src/index.ts"],
      "@jchaffin/voicekit-tools": ["packages/tools/src/index.ts"],
      "@jchaffin/voicekit-policy": ["packages/policy/src/index.ts"],
      "@jchaffin/voicekit-telemetry": ["packages/telemetry/src/index.ts"],
      "@jchaffin/voicekit-persistence": ["packages/persistence/src/index.ts"],
      "@jchaffin/voicekit-simulation": ["packages/simulation/src/index.ts"],
      "@jchaffin/voicekit-conformance": ["packages/conformance/src/index.ts"],
      "@jchaffin/voicekit-provider-openai": ["packages/provider-openai/src/index.ts"],
      "@jchaffin/voicekit-provider-elevenlabs": ["packages/provider-elevenlabs/src/index.ts"],
      "@jchaffin/voicekit-provider-deepgram": ["packages/provider-deepgram/src/index.ts"],
      "@jchaffin/voicekit-provider-assemblyai": ["packages/provider-assemblyai/src/index.ts"],
      "@jchaffin/voicekit-provider-cartesia": ["packages/provider-cartesia/src/index.ts"],
      "@jchaffin/voicekit-pipeline": ["packages/pipeline/src/index.ts"],
      "@jchaffin/voicekit-transport-livekit": ["packages/transport-livekit/src/index.ts"],
      "@jchaffin/voicekit-runtime-livekit": ["packages/runtime-livekit/src/index.ts"],
      "@jchaffin/voicekit-runtime-pipecat": ["packages/runtime-pipecat/src/index.ts"],
      "@jchaffin/voicekit-react": ["packages/react/src/index.ts"],
      "@jchaffin/voicekit-ui": ["packages/ui/src/index.ts"],
      "@jchaffin/voicekit-deploy": ["packages/deploy/src/index.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
